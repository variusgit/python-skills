{
  "$schema": "https://opencode.ai/config.json",

  "agent": {
    "build": {
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-20250514",
      "color": "#4CAF50",
      "prompt": "{file:.opencode/prompts/build.md}",
      "permission": {
        "skill": {
          "*": "deny",
          "senior-python-backend-data": "allow"
        },
        "task": {
          "*": "deny",
          "code-reviewer": "allow",
          "tester": "allow",
          "explore": "allow"
        }
      }
    },

    "plan": {
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-20250514",
      "color": "#2196F3",
      "prompt": "{file:.opencode/prompts/plan.md}",
      "permission": {
        "skill": {
          "*": "deny",
          "senior-python-backend-data": "allow"
        },
        "bash": "ask",
        "edit": "ask"
      }
    }
  }
}
